# Server Environment Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# Database (PostgreSQL via @applytrack/database)
DATABASE_URL="postgresql://user:password@localhost:5432/applytrack?schema=public"

# Redis & BullMQ
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Secrets
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Token Encryption Vault (AES-256-GCM - exactly 32 bytes / 64 hex characters)
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"

# Google Cloud Pub/Sub (users.watch notifications)
GOOGLE_PUBSUB_TOPIC="projects/your-project-id/topics/gmail-notifications"
GOOGLE_PUBSUB_VERIFICATION_TOKEN="custom-secure-pubsub-webhook-token"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:4000/api/v1/auth/github/callback"

# Web Push (VAPID Keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@applytrack.dev"

# Groq AI Ghostwriter (Llama 3.3 70B / Llama 3.1 8B Instant)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
